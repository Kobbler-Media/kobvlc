From 41ab356bfcd3a9a8d1244194a95d0e5daf28e9d3 Mon Sep 17 00:00:00 2001
Message-Id: <41ab356bfcd3a9a8d1244194a95d0e5daf28e9d3.1794375661.git.dev@kobbler.invalid>
From: Kobbler-Media <dev@kobbler.invalid>
Date: Wed, 14 Oct 2026 20:09:05 +1100
Subject: [PATCH 1/4] MediaPlayer: select the video track again when the
 surface returns

The player keeps the vout of a deselected track for reuse, so the vout
count does not drop to zero when the surface is destroyed. The track
disabled then was never selected again, and a paused video came back
black.
---
 .../main/java/org/videolan/libvlc/MediaPlayer.java   | 12 ++++++++++--
 1 file changed, 10 insertions(+), 2 deletions(-)

diff --git a/libvlc/src/main/java/org/videolan/libvlc/MediaPlayer.java b/libvlc/src/main/java/org/videolan/libvlc/MediaPlayer.java
index 8f84499..64e8b18 100644
--- a/libvlc/src/main/java/org/videolan/libvlc/MediaPlayer.java
+++ b/libvlc/src/main/java/org/videolan/libvlc/MediaPlayer.java
@@ -617,8 +617,9 @@ public class MediaPlayer extends VLCObject {
             synchronized (MediaPlayer.this) {
                 if (!mPlaying && mPlayRequested)
                     play = true;
-                else if (mVoutCount == 0)
+                else if (mVoutCount == 0 || mVideoDisabledForSurface)
                     enableVideo = true;
+                mVideoDisabledForSurface = false;
             }
             if (play)
                 play();
@@ -630,14 +631,21 @@ public class MediaPlayer extends VLCObject {
         public void onSurfacesDestroyed(AWindow vout) {
             boolean disableVideo = false;
             synchronized (MediaPlayer.this) {
-                if (mVoutCount > 0)
+                if (mVoutCount > 0) {
                     disableVideo = true;
+                    mVideoDisabledForSurface = true;
+                }
             }
             if (disableVideo)
                 setVideoTrackEnabled(false);
         }
     });
 
+    /* The player keeps the vout of a deselected track for reuse, so the vout count does
+     * not drop when the surface goes: without this, the track disabled here was never
+     * selected again and a paused video came back black. */
+    private boolean mVideoDisabledForSurface = false;
+
     private synchronized void updateAudioOutputDevice(long encodingFlags, String defaultDevice) {
         mCanDoPassthrough = encodingFlags != 0;
         final String newDeviceId = mAudioDigitalOutputEnabled && mCanDoPassthrough ? "encoded:" + encodingFlags : defaultDevice;
-- 

diff --git a/test/src/clock/input_clock.c b/test/src/clock/input_clock.c
new file mode 100644
index 0000000000..83181e5474
--- /dev/null
+++ b/test/src/clock/input_clock.c
@@ -0,0 +1,172 @@
+/*****************************************************************************
+ * clock/input_clock.c: test for the input clock discontinuity detection
+ *****************************************************************************
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License
+ * along with this program; if not, write to the Free Software Foundation,
+ * Inc., 51 Franklin Street, Fifth Floor, Boston MA 02110-1301, USA.
+ *****************************************************************************/
+
+#ifdef HAVE_CONFIG_H
+# include "config.h"
+#endif
+
+#undef NDEBUG
+#include <assert.h>
+#include <stdio.h>
+#include <stdlib.h>
+
+#include <vlc_common.h>
+#include <vlc_tick.h>
+
+#include "../../../src/clock/input_clock.h"
+
+const char vlc_module_name[] = "test_input_clock";
+
+struct scenario
+{
+    const char *name;
+    bool paced;
+    unsigned pcr_count;
+    vlc_tick_t pcr_interval;
+    /* Time the demuxer takes from one PCR to the next, once it is due to read. */
+    vlc_tick_t demux_cost;
+    unsigned jump_at;
+    vlc_tick_t jump;
+    unsigned expected_discontinuities;
+};
+
+struct run
+{
+    unsigned discontinuities;
+    vlc_tick_t stream_elapsed;
+    vlc_tick_t system_elapsed;
+};
+
+static vlc_tick_t
+on_update(void *opaque, vlc_tick_t ck_system, vlc_tick_t ck_stream,
+          double rate, bool discontinuity)
+{
+    (void) ck_system; (void) ck_stream; (void) rate;
+    struct run *run = opaque;
+    if (discontinuity)
+        run->discontinuities++;
+    return 0;
+}
+
+static const struct vlc_input_clock_cbs cbs = {
+    .update = on_update,
+};
+
+/* A paced input sleeps until the clock's wake-up date before demuxing on, as
+ * the input thread does; a live one receives each PCR at its own pace. */
+static struct run
+play(const struct scenario *s)
+{
+    struct run run = { 0 };
+    input_clock_t *clock = input_clock_New(NULL, 1.f);
+    assert(clock != NULL);
+    input_clock_AttachListener(clock, &cbs, &run);
+
+    const vlc_tick_t system_start = VLC_TICK_FROM_SEC(1000);
+    const vlc_tick_t stream_start = VLC_TICK_FROM_SEC(2451);
+    vlc_tick_t system = system_start;
+    vlc_tick_t stream = stream_start;
+
+    input_clock_Update(clock, s->paced, true, false, stream, system);
+    for (unsigned i = 1; i < s->pcr_count; i++)
+    {
+        if (s->paced)
+        {
+            vlc_tick_t wakeup = input_clock_GetWakeup(clock);
+            if (wakeup > system)
+                system = wakeup;
+        }
+        system += s->demux_cost;
+        stream += s->pcr_interval;
+        if (i == s->jump_at)
+            stream += s->jump;
+        input_clock_Update(clock, s->paced, false, false, stream, system);
+    }
+
+    run.stream_elapsed = stream - stream_start;
+    run.system_elapsed = system - system_start;
+    input_clock_Delete(clock);
+    return run;
+}
+
+static const struct scenario scenarios[] = {
+    {
+        .name = "paced input, PCRs further apart than the gap",
+        .paced = true, .pcr_count = 200,
+        .pcr_interval = VLC_TICK_FROM_MS(360), .demux_cost = VLC_TICK_FROM_MS(37),
+        .expected_discontinuities = 0,
+    },
+    {
+        .name = "paced input, PCRs most of a second apart",
+        .paced = true, .pcr_count = 60,
+        .pcr_interval = VLC_TICK_FROM_MS(900), .demux_cost = VLC_TICK_FROM_MS(37),
+        .expected_discontinuities = 0,
+    },
+    {
+        .name = "paced input, stream jumping forward",
+        .paced = true, .pcr_count = 200,
+        .pcr_interval = VLC_TICK_FROM_MS(40), .demux_cost = VLC_TICK_FROM_MS(2),
+        .jump_at = 100, .jump = VLC_TICK_FROM_SEC(2),
+        .expected_discontinuities = 1,
+    },
+    {
+        .name = "paced input, stream going backward",
+        .paced = true, .pcr_count = 200,
+        .pcr_interval = VLC_TICK_FROM_MS(40), .demux_cost = VLC_TICK_FROM_MS(2),
+        .jump_at = 100, .jump = -VLC_TICK_FROM_SEC(30),
+        .expected_discontinuities = 1,
+    },
+    {
+        .name = "live input, stream jumping forward",
+        .paced = false, .pcr_count = 200,
+        .pcr_interval = VLC_TICK_FROM_MS(40), .demux_cost = VLC_TICK_FROM_MS(40),
+        .jump_at = 100, .jump = VLC_TICK_FROM_SEC(1),
+        .expected_discontinuities = 1,
+    },
+    {
+        .name = "live input, stream outrunning the sender's pace",
+        .paced = false, .pcr_count = 10,
+        .pcr_interval = VLC_TICK_FROM_MS(360), .demux_cost = VLC_TICK_FROM_MS(37),
+        .expected_discontinuities = 9,
+    },
+};
+
+int main(void)
+{
+    int failures = 0;
+    for (size_t i = 0; i < ARRAY_SIZE(scenarios); i++)
+    {
+        const struct scenario *s = &scenarios[i];
+        struct run run = play(s);
+
+        bool ok = run.discontinuities == s->expected_discontinuities;
+        /* Whatever it reads, a paced input must not read ahead of real time. */
+        if (s->paced && s->jump == 0)
+            ok &= run.stream_elapsed - run.system_elapsed < VLC_TICK_FROM_SEC(1);
+
+        fprintf(stderr, "%s: %s: %u discontinuities (expected %u), "
+                "%"PRId64" ms of stream in %"PRId64" ms\n",
+                ok ? "ok" : "FAIL", s->name, run.discontinuities,
+                s->expected_discontinuities,
+                MS_FROM_VLC_TICK(run.stream_elapsed),
+                MS_FROM_VLC_TICK(run.system_elapsed));
+        if (!ok)
+            failures++;
+    }
+    return failures ? EXIT_FAILURE : EXIT_SUCCESS;
+}

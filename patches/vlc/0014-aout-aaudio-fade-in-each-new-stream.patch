+#ifndef VLC_ANDROID_FADE_H
+#define VLC_ANDROID_FADE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+struct android_fade
+{
+    float gain;
+    float step;
+};
+
+void android_fade_In(struct android_fade *, uint32_t frames);
+
+/* Interleaved FL32 or S16N samples, each frame at the gain the ramp reached. */
+void android_fade_Apply(struct android_fade *, void *samples, uint32_t frames,
+                        unsigned channels, bool fl32);
+
+#endif

References: <c4889cf191dc9761480d7bdfa95689fee684e027.1792809858.git.dev@kobbler.invalid>
From: Kobbler-Media <dev@kobbler.invalid>
Date: Wed, 14 Oct 2026 19:47:08 +1100
Subject: [PATCH 02/11] http: file: stop the old transfer before seeking

A server that has already honoured a range request will honour the next
one, so the response being replaced has nothing left to fall back to.
Kept running until the new response arrives, it fills the connection
with data that is never read, and on HTTP/2 the new response is queued
behind all of it: over Wi-Fi a seek to the cues at the end of a Matroska
file waited more than a second for its first byte.
---
 modules/access/http/file.c    | 8 ++++++++
 modules/access/http/message.c | 9 +++++++++
 modules/access/http/message.h | 7 +++++++
 3 files changed, 24 insertions(+)

diff --git a/modules/access/http/file.c b/modules/access/http/file.c
index 17ff23f991..2dca687b4b 100644
--- a/modules/access/http/file.c
+++ b/modules/access/http/file.c
@@ -203,6 +203,14 @@ bool vlc_http_file_can_seek(struct vlc_http_resource *res)
 
 int vlc_http_file_seek(struct vlc_http_resource *res, uintmax_t offset)
 {
+    /* A server that has already honoured a range will honour this one, so the
+     * old transfer has nothing left to fall back to. Left running until the new
+     * response arrives, it fills the connection with data nobody reads, and on
+     * HTTP/2 the new response queues behind all of it. Its headers stay: the
+     * new request is validated against them. */
+    if (res->response != NULL && vlc_http_msg_can_seek(res->response))
+        vlc_http_msg_close_payload(res->response);
+
     struct vlc_http_msg *resp = vlc_http_res_open(res, &offset);
     if (resp == NULL)
         return -1;
diff --git a/modules/access/http/message.c b/modules/access/http/message.c
index ba1a3f632c..2d44a5ce9a 100644
--- a/modules/access/http/message.c
+++ b/modules/access/http/message.c
@@ -262,6 +262,15 @@ void vlc_http_msg_attach(struct vlc_http_msg *m, struct vlc_http_stream *s)
     m->payload = s;
 }
 
+void vlc_http_msg_close_payload(struct vlc_http_msg *m)
+{
+    if (m->payload != NULL)
+    {
+        vlc_http_stream_close(m->payload, false);
+        m->payload = NULL;
+    }
+}
+
 struct vlc_http_msg *vlc_http_msg_iterate(struct vlc_http_msg *m)
 {
     struct vlc_http_msg *next = vlc_http_stream_read_headers(m->payload);
diff --git a/modules/access/http/message.h b/modules/access/http/message.h
index 9abfd131b3..37785eb0af 100644
--- a/modules/access/http/message.h
+++ b/modules/access/http/message.h
@@ -285,6 +285,13 @@ uintmax_t vlc_http_msg_get_size(const struct vlc_http_msg *);
  */
 struct vlc_http_msg *vlc_http_msg_iterate(struct vlc_http_msg *) VLC_USED;
 
+/**
+ * Stops receiving the payload of a message.
+ *
+ * The headers are kept, so that the message can still be queried.
+ */
+void vlc_http_msg_close_payload(struct vlc_http_msg *);
+
 /**
  * Gets final response headers.
  *
-- 

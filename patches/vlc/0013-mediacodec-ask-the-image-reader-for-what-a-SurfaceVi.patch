From d861d9e9cc8b701321f0c3960a81c86cd349c178 Mon Sep 17 00:00:00 2001
Message-Id: <d861d9e9cc8b701321f0c3960a81c86cd349c178.1792905594.git.dev@kobbler.invalid>
From: Kobbler-Media <dev@kobbler.invalid>
Date: Sun, 25 Oct 2026 18:00:00 +1100
Subject: [PATCH] mediacodec: ask the image reader for what a SurfaceView asks

10-bit HEVC played solid green on a Chromecast with Google TV HD while
8-bit HEVC and H.264 were clean, and the file decoded without an error in
software.

A codec2 decoder sees the consumer usage of the surface it is given and
may choose its output from it. The images of the AImageReader VLC decodes
into go straight to SurfaceFlinger through an ASurfaceControl, yet the
reader asked for no usage at all. Amlogic's decoders take a consumer
without GRALLOC_USAGE_HW_COMPOSER for a SurfaceTexture: they leave the
compressed output and the gralloc attributes the composer reads unset,
and for HEVC write the picture once at full size. The layer still goes to
the video plane, and there an 8-bit picture shows but a 10-bit one is
green.

Ask for what a SurfaceView's queue asks of a decoder, the composer and the
GPU (should SurfaceFlinger compose the layer itself), when the images are
presented directly. When VLC's OpenGL display samples them, as for
projections and rotations, the GPU usage alone stays.
---
 modules/codec/Makefile.am                 |  1 +
 modules/codec/omxil/aimage_reader_usage.h | 38 +++++++++++++++++++++++
 modules/codec/omxil/mediacodec.c          |  6 ++--
 3 files changed, 41 insertions(+), 4 deletions(-)
 create mode 100644 modules/codec/omxil/aimage_reader_usage.h

diff --git a/modules/codec/Makefile.am b/modules/codec/Makefile.am
index 46fd1b42e0..08ba041ed6 100644
--- a/modules/codec/Makefile.am
+++ b/modules/codec/Makefile.am
@@ -495,6 +495,7 @@ libomxil_plugin_la_LDFLAGS = $(AM_LDFLAGS) $(codec_RPATH)
 
 libmediacodec_plugin_la_CPPFLAGS = $(AM_CPPFLAGS) -I$(srcdir)/codec/omxil
 libmediacodec_plugin_la_SOURCES = codec/omxil/mediacodec.c codec/omxil/mediacodec.h \
+	codec/omxil/aimage_reader_usage.h \
 	codec/omxil/mediacodec_jni.c codec/omxil/mediacodec_ndk.c codec/omxil/utils.c \
 	codec/omxil/omxil_utils.h codec/omxil/qcom.c codec/omxil/qcom.h
 libmediacodec_plugin_la_LIBADD = libchroma_copy.la libvlc_hxxxhelper.la \
diff --git a/modules/codec/omxil/aimage_reader_usage.h b/modules/codec/omxil/aimage_reader_usage.h
new file mode 100644
index 0000000000..0decd1a289
--- /dev/null
+++ b/modules/codec/omxil/aimage_reader_usage.h
@@ -0,0 +1,38 @@
+/*****************************************************************************
+ * aimage_reader_usage.h: usage of the AImageReader MediaCodec decodes into
+ *****************************************************************************

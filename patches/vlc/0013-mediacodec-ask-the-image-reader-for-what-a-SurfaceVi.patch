+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License
+ * along with this program; if not, write to the Free Software Foundation,
+ * Inc., 51 Franklin Street, Fifth Floor, Boston MA 02110-1301, USA.
+ *****************************************************************************/
+
+#ifndef VLC_MEDIACODEC_AIMAGE_READER_USAGE_H
+#define VLC_MEDIACODEC_AIMAGE_READER_USAGE_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include <android/hardware_buffer.h>
+
+/* Without OpenGL in between, the images go straight to SurfaceFlinger, so ask
+ * for what a SurfaceView's queue asks: decoders choose their output for the
+ * consumer, and Amlogic's take one without the composer bit for a
+ * SurfaceTexture, whose 10-bit HEVC frames show green on the video plane. */
+static inline uint64_t AImageReaderUsage(bool need_gpu)
+{
+    uint64_t usage = AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE;
+    if (!need_gpu)
+        usage |= AHARDWAREBUFFER_USAGE_COMPOSER_OVERLAY;
+    return usage;
+}
+
+#endif
diff --git a/modules/codec/omxil/mediacodec.c b/modules/codec/omxil/mediacodec.c
index 4b8023d1e2..b9a9a56715 100644
--- a/modules/codec/omxil/mediacodec.c
+++ b/modules/codec/omxil/mediacodec.c
@@ -41,6 +41,7 @@
 #include <vlc_bits.h>
 
 #include "mediacodec.h"
+#include "aimage_reader_usage.h"
 #include "../codec/hxxx_helper.h"
 #include <OMX_Core.h>
 #include <OMX_Component.h>
@@ -952,12 +953,9 @@ CreateSurfaceFromAImageReader(decoder_t *p_dec, vlc_decoder_device *dec_dev,
 
     int32_t width = 1, height = 1; /* Ignored by MediaCodec */
     int32_t format = AIMAGE_FORMAT_PRIVATE;
-    uint64_t usage = 0;
+    uint64_t usage = AImageReaderUsage(need_gpu);
     int32_t max_images = 32;
 
-    if (need_gpu)
-        usage |= AHARDWAREBUFFER_USAGE_GPU_SAMPLED_IMAGE;
-
     AImageReader *reader;
     int32_t status = air_api->AImageReader.newWithUsage(width, height, format,
                                                         usage, max_images,

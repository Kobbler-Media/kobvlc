@@ -128,6 +130,8 @@ struct sys
     bool can_set_video_layout;
     android_video_context_t *avctx;
     struct subpicture sub;
+    struct android_pacing pacing;
+    bool vsync;
 
     struct {
         ASurfaceControl *sc;
@@ -434,6 +438,23 @@ delete_win:
     return -1;
 }
 
+static vlc_tick_t PaceRelease(struct sys *sys, const picture_t *pic,
+                              vlc_tick_t date)
+{
+    if (pic->date == VLC_TICK_INVALID)
+        return date;
+
+    int64_t vsync_time = 0, vsync_period = 0;
+    if (!sys->vsync || !android_vsync_Get(&vsync_time, &vsync_period))
+        vsync_period = 0;
+
+    int64_t release = android_pacing_Adjust(&sys->pacing,
+                                            NS_FROM_VLC_TICK(pic->date),
+                                            NS_FROM_VLC_TICK(date),
+                                            vsync_time, vsync_period);
+    return VLC_TICK_FROM_NS(release);
+}
+
 static void ASC_OnComplete(void *context, ASurfaceTransactionStats *stats)
 {
     picture_t *pic = context;
@@ -491,7 +512,8 @@ static void PrepareWithASC(vout_display_t *vd, picture_t *pic,
     int fence_fd = android_picture_ctx_get_fence_fd(apctx);
 
     asc_api->ASurfaceTransaction.setBuffer(txn, sys->asc.sc, buffer, fence_fd);
-    asc_api->ASurfaceTransaction.setDesiredPresentTime(txn, NS_FROM_VLC_TICK(date));
+    asc_api->ASurfaceTransaction.setDesiredPresentTime(txn,
+                            NS_FROM_VLC_TICK(PaceRelease(sys, pic, date)));
     asc_api->ASurfaceTransaction.apply(txn);
     asc_api->ASurfaceTransaction.delete(txn);
 
@@ -520,7 +542,8 @@ static void Prepare(vout_display_t *vd, picture_t *picture,
     assert(picture->context);
     assert(sys->asc.sc == NULL);
     if (sys->avctx->render_ts != NULL)
-        sys->avctx->render_ts(picture->context, date);
+        sys->avctx->render_ts(picture->context,
+                              PaceRelease(sys, picture, date));
 
     if (sys->sub.window != NULL)
         subpicture_Prepare(vd, subpicture);
@@ -639,6 +662,9 @@ static void Close(vout_display_t *vd)
     if (sys->sub.window != NULL)
         subpicture_CloseDisplay(vd);
 
+    if (sys->vsync)
+        android_vsync_Release();
+
     /* The window outlives the display when the player keeps it for the next
      * video, and the app may hand it a new surface in between: the next
      * display must fetch the surface again rather than reuse a dead one. */
@@ -720,6 +746,8 @@ static int Open(vout_display_t *vd,
     sys->awh = awh;
     sys->can_set_video_layout = can_set_video_layout;
     sys->asc.sc = NULL;
+    sys->vsync = false;
+    android_pacing_Init(&sys->pacing);
     sys->avctx = vlc_video_context_GetPrivate(context, VLC_VIDEO_CONTEXT_AWINDOW);
     assert(sys->avctx);
 
@@ -792,6 +820,10 @@ static int Open(vout_display_t *vd,
         vd->ops = &ops;
     }
 
+    sys->vsync = android_vsync_Hold();
+    msg_Dbg(vd, "release times paced %s vsync",
+            sys->vsync ? "to" : "without");
+
     return VLC_SUCCESS;
 }
 
diff --git a/modules/video_output/android/pacing.c b/modules/video_output/android/pacing.c
new file mode 100644
index 0000000000..2624e0ac2e
--- /dev/null
+++ b/modules/video_output/android/pacing.c
@@ -0,0 +1,233 @@
+/*****************************************************************************
+ * pacing.c: smooth and vsync-align Android video release times
+ *****************************************************************************
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License
+ * along with this program; if not, write to the Free Software Foundation,
+ * Inc., 51 Franklin Street, Fifth Floor, Boston MA 02110-1301, USA.
+ *****************************************************************************/
+
+/* The release time VLC computes for a picture carries the jitter of its
+ * timestamp: Matroska stores milliseconds, so 23.976fps arrives as 41 and
+ * 42ms steps. SurfaceFlinger presents a buffer on the first vsync whose
+ * expected present time is past the requested one, and the frame rate it
+ * grants the app can space those vsyncs a whole frame apart: a request a
+ * fraction of a millisecond late then waits a frame, and the next two
+ * pictures share a vsync. As Media3's VideoFrameReleaseHelper does, the
+ * timestamps are fitted to the detected frame duration and the release is
+ * moved onto the vsync it is closest to, ahead of it by most of a period. */
+
+#ifdef HAVE_CONFIG_H
+# include "config.h"
+#endif
+
+#include <stdlib.h>
+#include <string.h>
+
+#include "pacing.h"
+
+#define MAX_MATCHING_DIFFERENCE_NS 1000000
+#define VSYNC_OFFSET_PERCENT 80
+
+static void MatcherReset(struct android_frame_matcher *m)
+{
+    memset(m, 0, sizeof(*m));
+}
+
+static bool MatcherSynced(const struct android_frame_matcher *m)
+{
+    return m->count > ANDROID_PACING_SYNC_FRAMES && m->outlier_count == 0;
+}
+
+static bool MatcherLastIsOutlier(const struct android_frame_matcher *m)
+{
+    return m->count > 0
+        && m->outliers[(m->count - 1) % ANDROID_PACING_SYNC_FRAMES];
+}
+
+static int64_t MatcherDuration(const struct android_frame_matcher *m)
+{
+    return m->matching_count > 0 ? m->matching_sum / m->matching_count : 0;
+}
+
+static void MatcherNext(struct android_frame_matcher *m, int64_t pts)
+{
+    if (m->count == 0)
+        m->first_pts = pts;
+    else if (m->count == 1)
+    {
+        m->first_duration = pts - m->first_pts;
+        m->matching_sum = m->first_duration;
+        m->matching_count = 1;
+    }
+    else
+    {
+        bool *outlier = &m->outliers[m->count % ANDROID_PACING_SYNC_FRAMES];
+        if (llabs(pts - m->last_pts - m->first_duration)
+                <= MAX_MATCHING_DIFFERENCE_NS)
+        {
+            m->matching_count++;
+            m->matching_sum += pts - m->last_pts;
+            if (*outlier)
+            {
+                *outlier = false;
+                m->outlier_count--;
+            }
+        }
+        else if (!*outlier)
+        {
+            *outlier = true;
+            m->outlier_count++;
+        }
+    }
+    m->count++;
+    m->last_pts = pts;
+}
+
+static void EstimatorNext(struct android_pacing *p, int64_t pts)
+{
+    MatcherNext(p->current, pts);
+    if (MatcherSynced(p->current))
+        p->candidate_active = false;
+    else if (p->last_pts != INT64_MIN)
+    {
+        if (!p->candidate_active || MatcherLastIsOutlier(p->candidate))
+        {
+            MatcherReset(p->candidate);
+            MatcherNext(p->candidate, p->last_pts);
+        }
+        p->candidate_active = true;
+        MatcherNext(p->candidate, pts);
+    }
+    if (p->candidate_active && MatcherSynced(p->candidate))
+    {
+        struct android_frame_matcher *previous = p->current;
+        p->current = p->candidate;
+        p->candidate = previous;
+        p->candidate_active = false;
+    }
+    p->last_pts = pts;
+}
+
+static void EstimatorReset(struct android_pacing *p)
+{
+    MatcherReset(&p->matchers[0]);
+    MatcherReset(&p->matchers[1]);
+    p->current = &p->matchers[0];
+    p->candidate = &p->matchers[1];
+    p->candidate_active = false;
+    p->last_pts = INT64_MIN;
+}
+
+void android_pacing_Init(struct android_pacing *p)
+{
+    EstimatorReset(p);
+    p->anchored = false;
+    p->hysteresis = 0;
+    p->cached_pts = INT64_MIN;
+}
+
+static int64_t SmoothPts(struct android_pacing *p, int64_t pts)
+{
+    if (p->last_pts != INT64_MIN && pts <= p->last_pts)
+    {
+        /* A seek or a new stream: the frame rate has to be found again. */
+        EstimatorReset(p);
+        p->anchored = false;
+    }
+    EstimatorNext(p, pts);
+
+    int64_t duration = MatcherSynced(p->current)
+                     ? MatcherDuration(p->current) : 0;
+    if (duration <= 0)
+    {
+        p->anchored = false;
+        return pts;
+    }
+
+    if (p->anchored)
+    {
+        /* Counted from the timestamps, so pictures dropped before the
+         * display keep their slot. */
+        int64_t frames = (pts - p->anchor_pts + duration / 2) / duration;
+        int64_t smooth = p->anchor_smooth + frames * duration;
+        if (frames > 0 && llabs(smooth - pts) <= duration / 4)
+        {
+            p->anchor_pts = pts;
+            p->anchor_smooth = smooth;
+            return smooth;
+        }
+    }
+    p->anchored = true;
+    p->anchor_pts = pts;
+    p->anchor_smooth = pts;
+    return pts;
+}
+
+static int64_t SnapToVsync(struct android_pacing *p, int64_t release,
+                           int64_t vsync_time, int64_t period)
+{
+    int64_t count = (release - vsync_time) / period;
+    int64_t snapped = vsync_time + period * count;
+    int64_t before, after;
+    if (release <= snapped)
+    {
+        before = snapped - period;
+        after = snapped;
+    }
+    else
+    {
+        before = snapped;
+        after = snapped + period;
+    }
+    int64_t after_diff = after - release;
+    int64_t before_diff = release - before;
+
+    /* Hysteresis keeps a release that sits halfway between two vsyncs on the
+     * one it had, rather than flipping on every bit of residual jitter. */
+    int64_t diffs_diff = llabs(after_diff - before_diff);
+    if (diffs_diff < period / 2)
+    {
+        int64_t range = period / 4;
+        if (diffs_diff < range)
+        {
+            if (p->hysteresis == 0)
+                p->hysteresis = after_diff < before_diff ? -range : range;
+        }
+        else
+            p->hysteresis = 0;
+    }
+
+    return after_diff + p->hysteresis < before_diff ? after : before;
+}
+
+int64_t android_pacing_Adjust(struct android_pacing *p, int64_t pts,
+                              int64_t date, int64_t vsync_time,
+                              int64_t vsync_period)
+{
+    /* The same picture again, redisplayed while paused or forced out. */
+    if (pts == p->cached_pts && date == p->cached_date)
+        return p->cached_release;
+
+    if (pts != p->cached_pts)
+        p->cached_offset = SmoothPts(p, pts) - pts;
+    int64_t release = date + p->cached_offset;
+
+    if (vsync_period > 0)
+        release = SnapToVsync(p, release, vsync_time, vsync_period)
+                - vsync_period * VSYNC_OFFSET_PERCENT / 100;
+
+    p->cached_pts = pts;
+    p->cached_date = date;
+    p->cached_release = release;
+    return release;
+}

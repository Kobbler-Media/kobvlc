+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License
+ * along with this program; if not, write to the Free Software Foundation,
+ * Inc., 51 Franklin Street, Fifth Floor, Boston MA 02110-1301, USA.
+ *****************************************************************************/
+
+#ifndef VLC_ANDROID_PACING_H
+#define VLC_ANDROID_PACING_H
+
+#include <stdbool.h>
+#include <stdint.h>
+
+#define ANDROID_PACING_SYNC_FRAMES 15
+
+struct android_frame_matcher
+{
+    int64_t first_pts;
+    int64_t first_duration;
+    int64_t last_pts;
+    int64_t count;
+    int64_t matching_count;
+    int64_t matching_sum;
+    bool outliers[ANDROID_PACING_SYNC_FRAMES];
+    unsigned outlier_count;
+};
+
+struct android_pacing
+{
+    struct android_frame_matcher matchers[2];
+    struct android_frame_matcher *current, *candidate;
+    bool candidate_active;
+    int64_t last_pts;
+
+    bool anchored;
+    int64_t anchor_pts;
+    int64_t anchor_smooth;
+
+    int64_t hysteresis;
+
+    int64_t cached_pts;
+    int64_t cached_date;
+    int64_t cached_offset;
+    int64_t cached_release;
+};
+
+void android_pacing_Init(struct android_pacing *);
+
+/* All times in nanoseconds on CLOCK_MONOTONIC, except pts which is the
+ * picture timestamp in nanoseconds. vsync_period <= 0 disables snapping. */
+int64_t android_pacing_Adjust(struct android_pacing *, int64_t pts,
+                              int64_t date, int64_t vsync_time,
+                              int64_t vsync_period);
+
+#endif
diff --git a/modules/video_output/android/vsync.c b/modules/video_output/android/vsync.c
new file mode 100644
index 0000000000..78bf43a1ee
--- /dev/null
+++ b/modules/video_output/android/vsync.c
@@ -0,0 +1,244 @@
+/*****************************************************************************
+ * vsync.c: sample the vsync timeline the app's frames are presented on
+ *****************************************************************************
+ * This program is free software; you can redistribute it and/or modify it
+ * under the terms of the GNU Lesser General Public License as published by
+ * the Free Software Foundation; either version 2.1 of the License, or
+ * (at your option) any later version.
+ *
+ * This program is distributed in the hope that it will be useful,
+ * but WITHOUT ANY WARRANTY; without even the implied warranty of
+ * MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE. See the
+ * GNU Lesser General Public License for more details.
+ *
+ * You should have received a copy of the GNU Lesser General Public License
+ * along with this program; if not, write to the Free Software Foundation,
+ * Inc., 51 Franklin Street, Fifth Floor, Boston MA 02110-1301, USA.
+ *****************************************************************************/
+
+#ifdef HAVE_CONFIG_H
+# include "config.h"
+#endif
+
+#include <dlfcn.h>
+#include <pthread.h>
+#include <stdatomic.h>
+#include <time.h>
+
+#include <android/choreographer.h>
+#include <android/looper.h>
+
+#include "vsync.h"
+
+#define SAMPLE_INTERVAL_NS INT64_C(500000000)
+#define MAX_SAMPLE_AGE_NS INT64_C(2000000000)
+
+static struct
+{
+    AChoreographer *(*getInstance)(void);
+    void (*postFrameCallback64)(AChoreographer *,
+                                AChoreographer_frameCallback64, void *);
+    void (*postVsyncCallback)(AChoreographer *,
+                              AChoreographer_vsyncCallback, void *);
+    void (*registerRefreshRateCallback)(AChoreographer *,
+                                        AChoreographer_refreshRateCallback,
+                                        void *);
+    size_t (*getFrameTimelinesLength)(const AChoreographerFrameCallbackData *);
+    int64_t (*getExpectedPresentationTimeNanos)(
+            const AChoreographerFrameCallbackData *, size_t);
+} api;
+
+/* One sampler for the process: the NDK Choreographer belongs to the thread
+ * that created it and is never torn down, so a thread per display would leak
+ * one each time. Between users it sleeps on its looper without callbacks. */
+static struct
+{
+    pthread_once_t once;
+    pthread_mutex_t lock;
+    pthread_cond_t ready;
+    bool started, available;
+    ALooper *looper;
+    AChoreographer *choreographer;
+
+    atomic_uint users;
+    _Atomic int64_t time, period;
+
+    /* only touched on the sampler thread */
+    bool posted, resample;
+    int64_t pair_first;
+    int64_t next_sample;
+} sampler = {
+    .once = PTHREAD_ONCE_INIT,
+    .lock = PTHREAD_MUTEX_INITIALIZER,
+    .ready = PTHREAD_COND_INITIALIZER,
+};
+
+static int64_t Now(void)
+{
+    struct timespec ts;
+    clock_gettime(CLOCK_MONOTONIC, &ts);
+    return ts.tv_sec * INT64_C(1000000000) + ts.tv_nsec;
+}
+
+static void Publish(int64_t time, int64_t period)
+{
+    atomic_store_explicit(&sampler.period, period, memory_order_relaxed);
+    atomic_store_explicit(&sampler.time, time, memory_order_release);
+}
+
+static void SampleLater(void)
+{
+    sampler.posted = false;
+    sampler.next_sample = sampler.resample ? 0 : Now() + SAMPLE_INTERVAL_NS;
+    sampler.resample = false;
+}
+
+static void OnVsync(const AChoreographerFrameCallbackData *data, void *opaque)
+{
+    (void) opaque;
+    /* The timelines are spaced by the rate SurfaceFlinger grants the app,
+     * which is what its buffers are latched on, not the panel's. */
+    if (api.getFrameTimelinesLength(data) >= 2)
+    {
+        int64_t first = api.getExpectedPresentationTimeNanos(data, 0);
+        int64_t second = api.getExpectedPresentationTimeNanos(data, 1);
+        if (second > first)
+            Publish(first, second - first);
+    }
+    SampleLater();
+}
+
+static void OnFrame(int64_t frame_time, void *opaque)
+{
+    (void) opaque;
+    if (sampler.pair_first == 0)
+    {
+        sampler.pair_first = frame_time;
+        api.postFrameCallback64(sampler.choreographer, OnFrame, NULL);
+        return;
+    }
+    if (frame_time > sampler.pair_first)
+        Publish(frame_time, frame_time - sampler.pair_first);
+    sampler.pair_first = 0;
+    SampleLater();
+}
+
+static void OnRefreshRate(int64_t period, void *opaque)
+{
+    (void) period; (void) opaque;
+    Publish(0, 0);
+    if (sampler.posted)
+        sampler.resample = true;
+    else
+        sampler.next_sample = 0;
+}
+
+static void Post(void)
+{
+    sampler.posted = true;
+    if (api.postVsyncCallback != NULL)
+        api.postVsyncCallback(sampler.choreographer, OnVsync, NULL);
+    else
+    {
+        sampler.pair_first = 0;
+        api.postFrameCallback64(sampler.choreographer, OnFrame, NULL);
+    }
+}
+
+static void *Run(void *data)
+{
+    (void) data;
+    ALooper *looper = ALooper_prepare(0);
+    AChoreographer *choreographer = api.getInstance();
+
+    pthread_mutex_lock(&sampler.lock);
+    sampler.looper = looper;
+    sampler.choreographer = choreographer;
+    sampler.available = choreographer != NULL;
+    sampler.started = true;
+    pthread_cond_signal(&sampler.ready);
+    pthread_mutex_unlock(&sampler.lock);
+    if (choreographer == NULL)
+        return NULL;
+
+    if (api.registerRefreshRateCallback != NULL)
+        api.registerRefreshRateCallback(choreographer, OnRefreshRate, NULL);
+
+    for (;;)
+    {
+        int timeout = -1;
+        if (atomic_load(&sampler.users) > 0 && !sampler.posted)
+        {
+            int64_t wait = sampler.next_sample - Now();
+            if (wait <= 0)
+                Post();
+            else
+                timeout = wait / 1000000 + 1;
+        }
+        ALooper_pollOnce(timeout, NULL, NULL, NULL);
+    }
+    return NULL;
+}
+
+static void Start(void)
+{
+    void *lib = dlopen("libandroid.so", RTLD_NOW);
+    if (lib == NULL)
+        return;
+    api.getInstance = dlsym(lib, "AChoreographer_getInstance");
+    api.postFrameCallback64 = dlsym(lib, "AChoreographer_postFrameCallback64");
+    if (api.getInstance == NULL || api.postFrameCallback64 == NULL)
+        return;
+    api.registerRefreshRateCallback =
+        dlsym(lib, "AChoreographer_registerRefreshRateCallback");
+    api.postVsyncCallback = dlsym(lib, "AChoreographer_postVsyncCallback");
+    api.getFrameTimelinesLength =
+        dlsym(lib, "AChoreographerFrameCallbackData_getFrameTimelinesLength");
+    api.getExpectedPresentationTimeNanos = dlsym(lib,
+        "AChoreographerFrameCallbackData_getFrameTimelineExpectedPresentationTimeNanos");
+    if (api.getFrameTimelinesLength == NULL
+     || api.getExpectedPresentationTimeNanos == NULL)
+        api.postVsyncCallback = NULL;
+
+    pthread_t thread;
+    pthread_attr_t attr;
+    pthread_attr_init(&attr);
+    pthread_attr_setdetachstate(&attr, PTHREAD_CREATE_DETACHED);
+    if (pthread_create(&thread, &attr, Run, NULL) != 0)
+    {
+        pthread_attr_destroy(&attr);
+        return;
+    }
+    pthread_attr_destroy(&attr);
+
+    pthread_mutex_lock(&sampler.lock);
+    while (!sampler.started)
+        pthread_cond_wait(&sampler.ready, &sampler.lock);
+    pthread_mutex_unlock(&sampler.lock);
+}
+
+bool android_vsync_Hold(void)
+{
+    pthread_once(&sampler.once, Start);
+    if (!sampler.available)
+        return false;
+    if (atomic_fetch_add(&sampler.users, 1) == 0)
+    {
+        /* a sample left from an earlier user may predate a mode change */
+        Publish(0, 0);
+        ALooper_wake(sampler.looper);
+    }
+    return true;
+}
+
+void android_vsync_Release(void)
+{
+    atomic_fetch_sub(&sampler.users, 1);
+}
+
+bool android_vsync_Get(int64_t *time, int64_t *period)
+{
+    *time = atomic_load_explicit(&sampler.time, memory_order_acquire);
+    *period = atomic_load_explicit(&sampler.period, memory_order_relaxed);
+    return *period > 0 && Now() - *time < MAX_SAMPLE_AGE_NS;
+}

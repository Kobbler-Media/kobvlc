From 7569a748d6d008513cbf39061bc4db416ff59617 Mon Sep 17 00:00:00 2001
Message-Id: <7569a748d6d008513cbf39061bc4db416ff59617.1795068663.git.dev@kobbler.invalid>
From: Kobbler-Media <dev@kobbler.invalid>
Date: Thu, 19 Nov 2026 13:27:44 +1100
Subject: [PATCH 19/20] input_clock: measure a paced input's gaps against its
 last step

The gap check compares how far the stream moved between two PCRs with how
far the system date moved. For an input VLC paces itself (a file, HTTP)
the system date of a PCR is only when the input got to it. On schedule
the input reads on once the clock's wake-up date, the date of the last
PCR, is due, so its system date moves by the last step and the check
compares each step with the one before. Whenever the input is behind,
after a new reference or a stall on the network, it reads on at once and
the system date only measures how long the demuxer took.

So once a stream's PCRs come more than 300ms apart, the check trips each
time the input falls behind. The new reference then makes the PCR just
read due at once, the next is read at once and trips it again, and so on:
every PCR starts a new output clock context and the position runs ahead
of real time. A Matroska episode whose PCR now and then jumped 360ms
played its position nearly twice as fast as real time from one such
jump, 40s ahead of the picture within a minute.

A paced input's gap is now measured against its last step, what its
system date moves by on schedule, whenever it was actually read. The
300ms threshold is unchanged, live inputs still compare system dates, and
a stream going backward is still a discontinuity.
---
 src/clock/input_clock.c      |  16 ++-
 test/Makefile.am             |   5 +
 test/src/clock/input_clock.c | 205 +++++++++++++++++++++++++++++++++++
 test/src/meson.build         |  10 ++
 4 files changed, 235 insertions(+), 1 deletion(-)
 create mode 100644 test/src/clock/input_clock.c

diff --git a/src/clock/input_clock.c b/src/clock/input_clock.c
index 01d873b679..b09c780f6c 100644
--- a/src/clock/input_clock.c
+++ b/src/clock/input_clock.c
@@ -113,6 +113,8 @@ struct input_clock_t
     /* Last point
      * It is used to detect unexpected stream discontinuities */
     clock_point_t last;
+    /* Stream date of the point before it, since the reference */
+    vlc_tick_t prev_stream;
 
     /* Amount of extra buffering expressed in stream clock */
     vlc_tick_t i_buffering_duration;
@@ -178,6 +180,7 @@ input_clock_t *input_clock_New(struct vlc_logger *logger, float rate)
     cl->ref = clock_point_Create( VLC_TICK_INVALID, VLC_TICK_INVALID );
 
     cl->last = clock_point_Create( VLC_TICK_INVALID, VLC_TICK_INVALID );
+    cl->prev_stream = VLC_TICK_INVALID;
 
     cl->i_buffering_duration = 0;
 
@@ -246,7 +249,16 @@ vlc_tick_t input_clock_Update( input_clock_t *cl,
         /* We need compare both stream and system times for discontinuity.
          * Indeed, a big stream diff is OK if we have the same system diff. */
         vlc_tick_t stream_diff = i_ck_stream - cl->last.stream;
-        vlc_tick_t system_diff = (i_ck_system - cl->last.system) * cl->rate;
+        vlc_tick_t system_diff;
+        if (!b_can_pace_control)
+            system_diff = (i_ck_system - cl->last.system) * cl->rate;
+        else if (cl->prev_stream != VLC_TICK_INVALID)
+            /* A paced input reads on once the last PCR is due, or at once when
+             * it is behind: on schedule its system date moves by the last step,
+             * and the date it actually got there says nothing of the stream. */
+            system_diff = cl->last.stream - cl->prev_stream;
+        else
+            system_diff = stream_diff;
         vlc_tick_t diff = stream_diff - system_diff;
 
         /* A discontinuity happen if stream timings increase much more than
@@ -311,6 +323,7 @@ vlc_tick_t input_clock_Update( input_clock_t *cl,
     //fprintf( stderr, "input_clock_Update: %d :: %lld\n", b_extra_buffering_allowed, cl->i_buffering_duration/1000 );
 
     /* */
+    cl->prev_stream = b_reset_reference ? VLC_TICK_INVALID : cl->last.stream;
     cl->last = clock_point_Create( i_ck_system, i_ck_stream );
 
     /* It does not take the decoder latency into account but it is not really
@@ -337,6 +350,7 @@ void input_clock_Reset( input_clock_t *cl )
     cl->b_origin_changed = false;
     cl->ref = cl->last
         = clock_point_Create( VLC_TICK_INVALID, VLC_TICK_INVALID );
+    cl->prev_stream = VLC_TICK_INVALID;
 
     if (cl->listener.cbs != NULL && cl->listener.cbs->reset != NULL)
         cl->listener.cbs->reset(cl->listener.opaque);

# VideoLAN's libvlcjni at the commit we build from. It pins everything else: the VLC
# commit (VLC_TESTED_HASH in buildsystem/get-vlc.sh) and the Docker image its CI builds in
# (buildsystem/gitlab/.gitlab-ci.yml), which android/build.sh reads from it.
LIBVLCJNI_URL=https://code.videolan.org/videolan/libvlcjni.git
LIBVLCJNI_COMMIT=a8d53a9151d7e4a9a5dfd0a5eb1cd92669afdc21

# VLC for the Linux build. vlcj 5 binds the libvlc API as reworked on 2026-06-24, which the
# VLC libvlcjni pins predates, so desktop follows VLC master until libvlcjni catches up.
VLC_URL=https://code.videolan.org/videolan/vlc.git
VLC_DESKTOP_COMMIT=3127258a2dac31be87f4ead6492d3862a8a90a31

# What kobapp depends on: dev.kobbler.vlc:libvlc-all:$VERSION
GROUP=dev.kobbler.vlc
ARTIFACT=libvlc-all
VERSION=4.0.0-eap29-kob9
# What kobapp's desktop build unpacks: dev.kobbler.vlc:libvlc-linux-x64:$DESKTOP_VERSION
DESKTOP_VERSION=4.0.0-3127258a-kob3

MAVEN_HOST=10.0.0.145
MAVEN_DIR=dev/kobvlc/maven/data
MAVEN_URL=http://10.0.0.145:17900

# VideoLAN's libvlcjni at the commit we build from. Its CI file names the Docker image the
# Android build runs in (buildsystem/gitlab/.gitlab-ci.yml), which android/build.sh reads.
# Pinned at MR !246 ("Port libvlcjni to the reworked libvlc 4 API") until VideoLAN merges it;
# its master binds the libvlc API from before the June 2026 rework.
LIBVLCJNI_URL=https://code.videolan.org/videolan/libvlcjni.git
LIBVLCJNI_REF=refs/merge-requests/246/head
LIBVLCJNI_COMMIT=6ad75b5dbc3969c21a4de286ecb126ade742528f

# VLC for both builds, in place of libvlcjni's VLC_TESTED_HASH.
VLC_URL=https://code.videolan.org/videolan/vlc.git
VLC_COMMIT=fb39292a88396576b89d1f4c127e37c3007fb586

# What kobapp depends on: dev.kobbler.vlc:libvlc-all:$VERSION (Android) and
# dev.kobbler.vlc:libvlc-linux-x64:$VERSION (desktop).
GROUP=dev.kobbler.vlc
ARTIFACT=libvlc-all
VERSION=4.0.0-fb39292a-kob2
